# =============================================================================
# Variables de entorno — plantilla
# =============================================================================
#
# Copiá este archivo a `.env.local` y completá los valores reales:
#
#     cp .env.example .env.local        (Git Bash)
#     copy .env.example .env.local      (cmd.exe)
#
# `.env.local` está en .gitignore y NUNCA debe comitearse. Este archivo
# (.env.example) es la ÚNICA excepción, y por eso sólo lleva placeholders.
#
# Dónde salen los valores: Supabase -> proyecto `simoOS-prod` (equipo
# SimoLogic) -> Settings -> API.
#
# Las variables son las mismas para los dos módulos: Commercial Activity usa el
# schema `activity_report` y Forecast usa `pipeline_forecast`, pero ambos
# apuntan al mismo proyecto de Supabase.
#
# Recordatorio de higiene ya anotado en docs/ARQUITECTURA.md: la anon key
# quedó expuesta en una captura de pantalla en algún momento — conviene
# rotarla.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. La app (obligatorias)
# -----------------------------------------------------------------------------
# Settings -> API -> "Project URL" y "Project API keys / anon public".
# Van también en las variables de entorno de Vercel.
#
# El prefijo NEXT_PUBLIC_ significa que quedan embebidas en el bundle del
# navegador. Es correcto para estas dos: la anon key no da acceso a nada por sí
# sola — quien decide qué puede leer o escribir cada persona son las políticas
# de RLS sobre la sesión autenticada.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY


# -----------------------------------------------------------------------------
# 2. Administración — AHORA TAMBIÉN OBLIGATORIA EN PRODUCCIÓN
# -----------------------------------------------------------------------------
# Settings -> API -> "Project API keys / service_role".
#
# ⚠ CAMBIO DE ALCANCE (etapa AUTH2). Hasta el cambio obligatorio de contraseña,
#   esta clave era sólo local, para `scripts/grant-app-access.mjs`. Ya no:
#   `/api/auth/complete-password-change` la necesita EN EL SERVIDOR para bajar
#   `must_change_password` en `app_metadata`. Sin ella en Vercel, quien tenga
#   contraseña temporal cambia la contraseña pero NO se desbloquea, y queda
#   girando en /change-password.
#
#   Hay que agregarla en Vercel -> Settings -> Environment Variables.
#
# Dos usos, ambos legítimos:
#   - scripts/grant-app-access.mjs        (local)   otorga allowed_apps
#   - /api/auth/complete-password-change  (server)  libera must_change_password
# Los dos escriben `app_metadata`, que el navegador no puede tocar -- que es
# justamente por qué los permisos y el flag viven ahí y no en `user_metadata`.
#
# ⚠ SALTEA RLS por completo: lee y escribe cualquier tabla como superusuario.
#   Tres reglas, sin excepción:
#
#     1. NUNCA con prefijo NEXT_PUBLIC_ — quedaría publicada en el bundle que
#        descarga cualquier visitante del sitio. Sin el prefijo, Next la deja
#        sólo del lado del servidor.
#     2. En Vercel, sólo como variable de entorno del proyecto. Nunca en el
#        repo, ni en un archivo que se comitee.
#     3. NUNCA pegada en un chat, un ticket o una captura de pantalla.

SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
